#!/usr/bin/env bash
# claude-statusbar-hook <event>
# Invoked by Claude Code hooks. Reads JSON payload on stdin, writes per-session
# state to ~/.claude/statusbar/<session_id>.json, and pushes a per-window tmux
# flag (@claude_status) for immediate window-list highlighting.
#
# IMPORTANT: always exits 0 — must never break Claude.

set +e

EVENT="${1:-}"
JQ="$(command -v jq 2>/dev/null)"
DIR="$HOME/.claude/statusbar"

# Bail out silently if jq is unavailable
[ -n "$JQ" ] || exit 0

TMP=""
trap '[ -n "$TMP" ] && rm -f "$TMP"' EXIT

# Read stdin fully (hook payload)
INPUT="$(cat 2>/dev/null)"

# Extract session_id — nothing to do without it
SID="$("$JQ" -r '.session_id // empty' <<<"$INPUT" 2>/dev/null)"
[ -z "$SID" ] && exit 0

CWD="$("$JQ" -r '.cwd // empty' <<<"$INPUT" 2>/dev/null)"
PANE="${TMUX_PANE:-}"

# Find the Claude PID by walking up the process tree until one has a matching
# sessions/<PID>.json. NOT $PPID: Claude Code runs hook commands through a
# shell, so the parent is that shell (observed: sh -> bash -> claude). Getting
# this wrong is silent — claude-statusbar-status treats a pid with no live
# session as stale and deletes the state file within one status-interval, so
# the indicator simply never appears.
# ps rather than /proc: this script also runs on macOS.
#
# Cross-checks liveness with kill -0, exactly as claude-statusbar-status does:
# session files outlive their process, so a recycled PID could otherwise match
# a dead session and produce state the reader will not count.
_find_claude_pid() {
    local p="${PPID:-0}" i
    for i in 1 2 3 4 5 6 7 8; do
        case "$p" in ''|0|1) return 1 ;; esac
        if [ -f "$HOME/.claude/sessions/$p.json" ] && kill -0 "$p" 2>/dev/null; then
            printf '%s' "$p"; return 0
        fi
        p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -cd '0-9')"
    done
    return 1
}

# macOS date lacks %3N (milliseconds) — use seconds * 1000 instead
NOW="$(( $(date +%s) * 1000 ))"

mkdir -p "$DIR" 2>/dev/null

# Map event → state
case "$EVENT" in
    SessionEnd)
        rm -f "$DIR/$SID.json" 2>/dev/null
        STATE=""
        ;;
    Notification|Stop)
        STATE="waiting"
        ;;
    SessionStart|UserPromptSubmit|PreToolUse|*)
        STATE="working"
        ;;
esac

# Resolved here, not earlier: SessionEnd teardown below must run even when the
# walk fails, or a state file recording a still-live pid is never purged and
# the indicator shows a phantom session for the life of the tmux server.
#
# An unresolvable pid means writing nothing at all. Writing 0 would be worse:
# claude-statusbar-status deletes such a file and unsets @claude_status, so the
# indicator appears and then vanishes on its own, taking any good state for
# this session with it. This happens legitimately — SessionStart fires before
# Claude Code has written sessions/<PID>.json.
CPID="$(_find_claude_pid)" || CPID=""
case "$CPID" in *[!0-9]*) CPID="" ;; esac
[ -n "$CPID" ] || STATE=""

# Write state file atomically (temp + mv, no flock on macOS)
if [ -n "$STATE" ]; then
    TMP="$DIR/.$SID.$$.tmp"
    "$JQ" -n \
        --arg  sid   "$SID"   \
        --arg  st    "$STATE" \
        --arg  cwd   "$CWD"   \
        --arg  pane  "$PANE"  \
        --argjson pid  "$CPID" \
        --argjson ts   "$NOW"  \
        '{session_id:$sid, state:$st, cwd:$cwd, tmux_pane:$pane, pid:$pid, updated_at:$ts}' \
        >"$TMP" 2>/dev/null \
    && mv -f "$TMP" "$DIR/$SID.json" 2>/dev/null
fi

# Push per-window tmux flag (instant highlight, no status-interval delay).
# With no state file written there is nothing for the reader to purge, so the
# flag would never be cleared — hence it is only set alongside a written state.
if [ -n "$PANE" ] && command -v tmux >/dev/null 2>&1; then
    if [ "$STATE" = "waiting" ]; then
        tmux set-option -w -t "$PANE" @claude_status waiting 2>/dev/null
    elif [ "$STATE" = "working" ]; then
        tmux set-option -w -t "$PANE" @claude_status working 2>/dev/null
    else
        tmux set-option -uw -t "$PANE" @claude_status 2>/dev/null
    fi
fi

exit 0
